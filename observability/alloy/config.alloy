loki.source.file "active" {
  targets = [{
    "__path__" = "/var/log/intelbras-event-engine/intelbras-event-engine.json",
    "service"  = "intelbras-event-engine",
  }]

  forward_to    = [loki.process.intelbras.receiver]
  tail_from_end = false

  file_match {
    enabled     = true
    sync_period = "10s"
  }
}

loki.source.file "archives" {
  targets = [{
    "__path__" = "/var/log/intelbras-event-engine/intelbras-event-engine.json.*.gz",
    "service"  = "intelbras-event-engine",
  }]

  forward_to = [loki.process.intelbras.receiver]

  file_match {
    enabled     = true
    sync_period = "10s"
  }

  decompression {
    enabled       = true
    format        = "gz"
    initial_delay = "10s"
  }
}

loki.process "intelbras" {
  stage.json {
    expressions = {
      ts    = "\"@timestamp\"",
      level = "level",
    }
  }

  stage.timestamp {
    source = "ts"
    format = "RFC3339Nano"
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
